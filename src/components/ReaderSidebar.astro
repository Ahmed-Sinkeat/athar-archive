---
// Shared sidebar shell for any reader page (book chapters, small books, poems,
// articles). ONE DOM node serves both breakpoints: a sticky rail on desktop, a
// fixed bottom sheet on mobile (.is-open, toggled from the topbar's
// [data-action="sidebar:mobile-toggle"] button — reader.ts).
//
// It used to render its slot TWICE (an extra <details> clone for mobile), so
// every prerendered chapter page stored in R2 carried the whole book TOC twice
// — the single biggest source of duplicated bytes in a 60GB bucket. The mobile
// clone's <summary> was display:none anyway, so it was never a JS-off fallback:
// the sheet has always been JS-only, and prev/next + the book landing page are
// what keep navigation working without scripts.
interface Props {
  label: string;
}
const { label } = Astro.props;
---
<aside class="toc-side chap-toc-aside" data-mobile-sidebar aria-label={label}>
  <div class="toc-sheet-head">{label}</div>
  <slot />
</aside>
