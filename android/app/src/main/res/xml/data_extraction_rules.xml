<?xml version="1.0" encoding="utf-8"?>
<!--
  API 31+. The platform separates the two channels, so we can be exact:
  settings go anywhere, private user data goes device-to-device only, and
  rebuildable content goes nowhere.
-->
<data-extraction-rules>
    <cloud-backup>
        <include domain="sharedpref" path="athar_appearance.xml" />
        <include domain="file" path="datastore/settings.preferences_pb" />
    </cloud-backup>

    <device-transfer>
        <include domain="sharedpref" path="athar_appearance.xml" />
        <include domain="sharedpref" path="audio_playback.xml" />
        <include domain="sharedpref" path="audio_queue.xml" />
        <include domain="file" path="datastore/settings.preferences_pb" />
        <include domain="database" path="athar_user.db" />
    </device-transfer>
</data-extraction-rules>
