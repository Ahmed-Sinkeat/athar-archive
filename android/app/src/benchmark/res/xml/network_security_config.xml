<?xml version="1.0" encoding="utf-8"?>
<!-- Benchmark builds only: trusts a throwaway self-signed cert for https://localhost, so a
     local content server (adb reverse) can be tested end to end without relaxing HTTPS. -->
<network-security-config>
    <domain-config>
        <domain includeSubdomains="false">localhost</domain>
        <trust-anchors>
            <certificates src="@raw/local_content_cert" />
            <certificates src="system" />
        </trust-anchors>
    </domain-config>
</network-security-config>
